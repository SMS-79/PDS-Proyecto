package inf.pds.proy.adapters.rest;

import java.util.List;

import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import inf.pds.proy.domain.model.ListaTareas;
import inf.pds.proy.domain.model.Tarjeta;
import inf.pds.proy.domain.ports.input.ListaTareasService;

@RestController
@RequestMapping("/api/listas")
public class ListaTareasController {

    private final ListaTareasService listaTareasService;

    public ListaTareasController(ListaTareasService listaTareasService) {
        this.listaTareasService = listaTareasService;
    }

    @PostMapping
    public ResponseEntity<ListaTareas> crearLista(@RequestParam String tipo,
                                                   @RequestParam Long tableroId) {
        return ResponseEntity.ok(listaTareasService.crearListaTareas(tipo, tableroId));
    }

    @GetMapping
    public ResponseEntity<List<ListaTareas>> obtenerListas() {
        return ResponseEntity.ok(listaTareasService.obtenerListasTareas());
    }

    @GetMapping("/{id}")
    public ResponseEntity<ListaTareas> obtenerLista(@PathVariable Long id) {
        return listaTareasService.filtrarListaById(id)
            .map(ResponseEntity::ok)
            .orElse(ResponseEntity.notFound().build());
    }

    @DeleteMapping("/{id}")
    public ResponseEntity<Void> eliminarLista(@PathVariable Long id) {
        listaTareasService.eliminarLista(id);
        return ResponseEntity.noContent().build();
    }

    @PostMapping("/{id}/tarjetas")
    public ResponseEntity<ListaTareas> añadirTarjeta(@PathVariable Long id,
                                                      @RequestBody Tarjeta tarjeta) {
        return ResponseEntity.ok(listaTareasService.addTarjeta(id, tarjeta));
    }

    @DeleteMapping("/{listaId}/tarjetas/{tarjetaId}")
    public ResponseEntity<Void> eliminarTarjeta(@PathVariable Long listaId,
                                                 @PathVariable Long tarjetaId) {
        listaTareasService.eliminarTarjeta(listaId, tarjetaId);
        return ResponseEntity.noContent().build();
    }
}